    </article>

    <article class="project-sheet">
      <div class="project-media">
        <svg viewBox="0 0 260 200">
          <rect x="30" y="60" width="200" height="80" rx="4"/>
          <line x1="50" y1="80" x2="210" y2="80"/>
          <line x1="50" y1="100" x2="210" y2="100"/>
