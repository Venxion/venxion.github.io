<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Haven Dao — Mechanical Engineer</title>
<meta name="description" content="Portfolio of Haven Dao, mechanical engineer with an aerospace engineering minor.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&family=Titillium+Web:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --navy: #10233D;
    --navy-deep: #0B1A2E;
    --line: #E7E5DF;
    --line-dim: rgba(231,229,223,0.30);
    --steel: #8B96A0;
    --red: #C8102E;
    --red-deep: #8E0B21;
    --paper: #FFFFFF;
    --paper-alt: #F4F5F3;
    --ink: #161616;
    --ink-soft: #4A4F55;
    --hair: #D7DAD6;

    --f-display: 'Jost', sans-serif;
    --f-body: 'Titillium Web', sans-serif;
    --f-mono: 'IBM Plex Mono', monospace;

    --edge: 28px;
  }

  *{ box-sizing: border-box; }
  html{ scroll-behavior: smooth; }
  body{
    margin:0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--f-body);
    font-size: 16px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  img{ max-width:100%; display:block; }
  a{ color: inherit; }
  h1,h2,h3{ font-family: var(--f-display); margin:0; letter-spacing: -0.01em; font-weight:600; }
  p{ margin:0; }
  .mono{ font-family: var(--f-mono); }

  .wrap{ max-width: 1180px; margin: 0 auto; padding: 0 var(--edge); }

  a:focus-visible, button:focus-visible{
    outline: 2px solid var(--red);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce){
    *{ animation: none !important; transition: none !important; }
  }

  header.site-nav{
    position: sticky; top:0; z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--hair);
  }
  .nav-row{
    display:flex; align-items:center; justify-content:space-between;
    padding: 18px var(--edge);
  }
  .nav-mark{
    font-family: var(--f-display); font-weight:700; font-size: 1.05rem;
    display:flex; align-items:center; gap:10px;
  }
  .nav-mark .dot{ width:9px; height:9px; background: var(--red); flex:none; }
  nav.links{ display:flex; gap: 28px; }
  nav.links a{
    text-decoration:none; font-size:0.92rem; color: var(--ink-soft);
    border-bottom: 1px solid transparent; padding-bottom: 3px;
  }
  nav.links a:hover{ color: var(--ink); border-bottom-color: var(--red); }
  .nav-cta{
    font-size:0.85rem; font-family: var(--f-mono);
    border:1px solid var(--ink); padding: 8px 14px;
    text-decoration:none; white-space:nowrap;
  }
  .nav-cta:hover{ background: var(--ink); color: var(--paper); }

  .hero{
    background: var(--navy);
    color: var(--line);
    position:relative;
    overflow:hidden;
    border-bottom: 1px solid var(--navy-deep);
  }
  .hero-grid{
    position:absolute; inset:0;
    background-image:
      linear-gradient(var(--line-dim) 1px, transparent 1px),
      linear-gradient(90deg, var(--line-dim) 1px, transparent 1px);
    background-size: 42px 42px;
    opacity: 0.15;
    pointer-events:none;
  }
  .hero-inner{
    position:relative;
    display:grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items:center;
    padding: 88px var(--edge) 70px;
  }
  .sheet-tag{
    font-family: var(--f-mono); font-size: 0.78rem;
    color: var(--red); letter-spacing: 0.02em;
    margin-bottom: 22px; display:block;
  }
  .hero h1{
    font-size: clamp(2.4rem, 4.4vw, 3.6rem);
    line-height: 1.08;
    color: var(--paper);
    font-weight: 600;
  }
  .hero h1 span{ color: var(--steel); font-weight:400; }
  .hero-sub{ margin-top: 22px; max-width: 46ch; font-size: 1.05rem; color: var(--line); }
  .hero-specs{ margin-top: 34px; display:flex; gap: 34px; flex-wrap:wrap; }
  .spec{ border-left: 2px solid var(--red); padding-left: 12px; }
  .spec .num{ font-family: var(--f-mono); font-size:1.3rem; color: var(--paper); display:block; }
  .spec .label{ font-size:0.78rem; color: var(--steel); }
  .hero-actions{ margin-top:36px; display:flex; gap:16px; flex-wrap:wrap; }
  .btn{
    font-family: var(--f-mono); font-size:0.88rem;
    padding: 12px 20px; text-decoration:none;
    border:1px solid var(--line); color: var(--paper);
    display:inline-block;
  }
  .btn.primary{ background: var(--red); border-color: var(--red); color: var(--paper); font-weight:500; }
  .btn.primary:hover{ background: var(--paper); border-color: var(--paper); color: var(--navy-deep); }
  .btn:not(.primary):hover{ border-color: var(--paper); }

  .schematic{ position:relative; }
  .schematic svg{ width:100%; height:auto; overflow:visible; }
  .schematic path, .schematic circle, .schematic line{
    stroke: var(--line); fill:none; stroke-width:1.4;
  }
  .schematic .draw{
    stroke-dasharray: 900; stroke-dashoffset: 900;
    animation: draw-in 2.6s ease forwards 0.3s;
  }
  .schematic .flow{
    stroke: var(--line); opacity:0.55; stroke-width:1;
    stroke-dasharray: 500; stroke-dashoffset: 500;
    animation: draw-in 2.2s ease forwards 0.6s;
  }
  .schematic .accent{ stroke: var(--red); }
  .schematic .dim-text{
    font-family: var(--f-mono); font-size: 10px; fill: var(--steel); stroke:none;
    opacity:0; animation: fade-in 0.6s ease forwards 2.4s;
  }
  .schematic .accent-text{
    font-family: var(--f-mono); font-size: 10px; fill: var(--red); stroke:none;
    opacity:0; animation: fade-in 0.6s ease forwards 2.6s;
  }
  @keyframes draw-in{ to{ stroke-dashoffset: 0; } }
  @keyframes fade-in{ to{ opacity:1; } }

  section{ padding: 90px 0; }
  .section-head{
    display:flex; justify-content:space-between; align-items:flex-end;
    margin-bottom: 48px; gap: 24px; flex-wrap:wrap;
  }
  .section-head h2{ font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .section-num{ font-family: var(--f-mono); font-size:0.8rem; color: var(--red); }
  .section-note{ max-width: 40ch; font-size:0.92rem; color: var(--ink-soft); text-align:right; }
  @media (max-width: 720px){ .section-note{ text-align:left; } }

  .about-grid{ display:grid; grid-template-columns: 0.7fr 1.3fr; gap: 60px; }
  .about-photo{
    aspect-ratio: 4/5; background: var(--paper-alt); border: 1px solid var(--hair); position:relative;
  }
  .about-photo::before{
    content:"FIG. 01 — PORTRAIT";
    position:absolute; bottom:10px; left:10px;
    font-family: var(--f-mono); font-size:0.68rem; color: var(--steel);
  }
  .about-text p{ font-size:1.05rem; color: var(--ink-soft); margin-bottom: 18px; max-width: 62ch; }
  .about-text p:last-child{ margin-bottom:0; }
  .about-text strong{ color: var(--ink); font-weight:600; }

  .projects{ background: var(--paper-alt); }
  .project-sheet{
    background: var(--paper); border: 1px solid var(--hair);
    margin-bottom: 26px; position:relative;
    display:grid; grid-template-columns: 1fr 1fr;
  }
  .project-sheet:last-child{ margin-bottom:0; }
  .project-sheet::before, .project-sheet::after{
    content:""; position:absolute; width:10px; height:10px;
    border: 1px solid var(--steel); opacity:0.6;
  }
  .project-sheet::before{ top:-1px; left:-1px; border-right:none; border-bottom:none; }
  .project-sheet::after{ bottom:-1px; right:-1px; border-left:none; border-top:none; }

  .project-media{
    background: var(--navy); min-height: 320px;
    display:flex; align-items:center; justify-content:center;
    position:relative; padding: 24px;
  }
  .project-media svg{ width:100%; max-width:280px; }
  .project-media path, .project-media circle, .project-media rect, .project-media line{
    stroke: var(--line); fill:none; stroke-width:1.3;
  }
  .project-media .accent{ stroke: var(--red); }

  .project-body{ padding: 40px; display:flex; flex-direction:column; }
  .project-code{ font-family: var(--f-mono); font-size:0.78rem; color: var(--red); margin-bottom:14px; }
  .project-body h3{ font-size:1.4rem; margin-bottom:12px; }
  .project-body .desc{ color: var(--ink-soft); font-size:0.98rem; margin-bottom:22px; }
  .project-stats{ display:flex; gap:28px; margin-bottom: 24px; flex-wrap:wrap; }
  .project-stats .stat .num{ font-family:var(--f-mono); font-size:1.1rem; display:block; }
  .project-stats .stat .label{ font-size:0.74rem; color: var(--steel); }
  .tags{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:26px; }
  .tag{
    font-family: var(--f-mono); font-size:0.72rem;
    border: 1px solid var(--hair); padding: 5px 10px; color: var(--ink-soft);
  }
  .project-links{ margin-top:auto; display:flex; gap:20px; }
  .project-links a{
    font-size:0.88rem; text-decoration:none; border-bottom: 1px solid var(--ink); padding-bottom:2px;
  }
  .project-links a:hover{ border-bottom-color: var(--red); color: var(--red); }

  @media (max-width: 820px){
    .project-sheet{ grid-template-columns: 1fr; }
    .project-media{ min-height: 220px; }
  }

  .skills-grid{
    display:grid; grid-template-columns: repeat(3, 1fr); gap: 1px;
    background: var(--hair); border: 1px solid var(--hair);
  }
  .skill-block{ background: var(--paper); padding: 32px; }
  .skill-block h3{ font-family: var(--f-mono); font-size:0.82rem; color: var(--red); margin-bottom: 20px; }
  .skill-block ul{ list-style:none; margin:0; padding:0; }
  .skill-block li{ font-size:0.94rem; color: var(--ink-soft); padding: 8px 0; border-bottom: 1px dashed var(--hair); }
  .skill-block li:last-child{ border-bottom:none; }
  @media (max-width: 820px){ .skills-grid{ grid-template-columns:1fr; } }

  .exp-row{
    display:grid; grid-template-columns: 160px 1fr; gap: 30px;
    padding: 26px 0; border-bottom: 1px solid var(--hair);
  }
  .exp-row:first-child{ border-top: 1px solid var(--hair); }
  .exp-date{ font-family: var(--f-mono); font-size:0.85rem; color: var(--steel); }
  .exp-role{ font-weight:600; font-size:1.05rem; margin-bottom:6px; }
  .exp-org{ color: var(--red); font-size:0.92rem; margin-bottom:10px; }
  .exp-desc{ color: var(--ink-soft); font-size:0.95rem; max-width: 62ch; }
  .resume-cta{ margin-top: 34px; }

  .contact{ background: var(--navy); color: var(--line); }
  .contact .wrap{ display:grid; grid-template-columns: 1.2fr 0.8fr; gap: 40px; align-items:end; }
  .contact h2{ color: var(--paper); font-size: clamp(1.8rem, 3.4vw, 2.6rem); max-width: 16ch; font-weight:600; }
  .contact-links{ display:flex; flex-direction:column; gap:14px; align-items:flex-start; }
  @media (max-width: 720px){
    .contact .wrap{ grid-template-columns:1fr; }
    .contact-links{ margin-top: 10px; }
  }
  .contact-links a{
    text-decoration:none; font-family: var(--f-mono); font-size:0.95rem;
    border-bottom: 1px solid var(--line-dim); padding-bottom:3px;
  }
  .contact-links a:hover{ border-bottom-color: var(--red); color: var(--red); }

  footer{
    background: var(--navy-deep); color: var(--steel);
    font-size: 0.8rem; font-family: var(--f-mono);
    padding: 22px var(--edge);
    display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;
  }

  @media (max-width: 900px){
    .hero-inner{ grid-template-columns: 1fr; padding-top:64px; }
    .about-grid{ grid-template-columns:1fr; gap: 30px; }
    .about-photo{ max-width: 260px; }
  }
  @media (max-width: 640px){
    nav.links{ display:none; }
    .nav-cta{ display:none; }
    section{ padding: 60px 0; }
  }
</style>
</head>
